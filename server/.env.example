# ---- 数据库 ----
# MySQL（生产）：mysql+pymysql://用户名:密码@主机:端口/topc?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/topc?charset=utf8mb4
# 留空则自动使用 SQLite 本地文件 topc.db（开发调试方便）
# DATABASE_URL=

# ---- QQ 邮箱 SMTP ----
# 在 QQ 邮箱 设置 -> 账户 -> POP3/SMTP服务 开启并生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
# 授权码（不是 QQ 密码）
SMTP_PASSWORD=
# 发件人显示名
SMTP_FROM_NAME=TopC 社团看板

# 留空则进入模拟模式：不真发邮件，只在控制台和 reminder_logs 表记录
# SMTP_USER=

# ---- 提醒任务 ----
# 每隔多少分钟检查一次是否需要发提醒
REMINDER_INTERVAL_MINUTES=30

# ---- 管理员 ----
# 管理后台登录密码（未登录访客只读）
ADMIN_PASSWORD=topc2026
# 登录 token 派生密钥，修改后所有已登录会话立即失效
SECRET_KEY=topc-dev-secret-change-me

# 浏览器 CORS 来源，逗号分隔（同域 Nginx 反代时可不改）
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
