# Docker Compose 会读取项目根目录这份 .env
# 复制：copy .env.example .env   （Windows）或  cp .env.example .env

# 对外端口（本地建议 8080；服务器可改成 80）
WEB_PORT=8080

# 管理员（上线务必改掉）
ADMIN_PASSWORD=topc2026
SECRET_KEY=change-me-in-production

# 数据库：默认 SQLite 写在 Docker volume 里，一般不用改
# DATABASE_URL=sqlite:////data/topc.db
# MySQL 示例（Docker 访问宿主机数据库用 host.docker.internal）：
# DATABASE_URL=mysql+pymysql://用户:密码@host.docker.internal:3306/库名?charset=utf8mb4

# QQ 邮箱 SMTP（留空 = 模拟发送）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=TopC 社团看板
REMINDER_INTERVAL_MINUTES=30

# 浏览器跨域来源（同域 Nginx 反代时通常用不到，本地调试可保留）
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# MCP 允许的 Host（公网 IP 或域名，逗号分隔；不填则 421 Invalid Host header）
MCP_ALLOWED_HOSTS=127.0.0.1,localhost,124.222.172.245
MCP_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost,http://124.222.172.245
